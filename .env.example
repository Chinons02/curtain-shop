# .env.example — copy this to .env and fill in values for local development
# DO NOT commit the real .env file to GitHub (it is already in .gitignore)

SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL blank locally — SQLite will be used automatically
DATABASE_URL=
